# ============================================================
# .gitignore minimo: se versiona TODO (datos, modelos, figuras,
# resultados) para que el proyecto sea 100% reproducible.
# Solo se ignoran cachés, entornos virtuales, basura del IDE/SO y secretos.
# ============================================================

# Cachés de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# Entornos virtuales
.venv/
venv/
env/

# Carpeta .git interna de datasets clonados (no es un submódulo válido)
data/raw/openfootball-worldcup/.git/

# IDE / Sistema operativo
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Secretos / credenciales (NUNCA subir)
.env
*.key
kaggle.json
